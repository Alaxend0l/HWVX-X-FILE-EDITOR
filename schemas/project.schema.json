{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alaxendol/HWVX-X-FILE-EDITOR/schemas/project.schema.json",
  "title": "HWVX Velocity X build project (v1)",
  "description": "hwvx.project.json: archives assembled from extracted vendor packs, project-internal split-pack folders and raw blobs. Generated by hwvx-x schema project; this file and src/compiler/project.rs are kept in step.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "archives"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "default_platform": { "$ref": "#/$defs/platform" },
    "container": { "$ref": "#/$defs/container" },
    "targets": {
      "type": "array",
      "items": { "$ref": "#/$defs/target" }
    },
    "default_targets": {
      "type": "array",
      "items": { "type": "string" }
    },
    "archives": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/archive" }
    }
  },
  "$defs": {
    "platform": {
      "description": "Target game build; selects byte order and archive rules.",
      "enum": ["pc", "gc", "ps2", "ps2-beta"]
    },
    "container": {
      "description": "Output container: classic game archive, or the XNC next container.",
      "enum": ["xarchive", "xnc"]
    },
    "packType": {
      "description": "Pack type: a known name (car, interface, item, world, geometry, ...) or a raw numeric id.",
      "anyOf": [
        { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        { "type": "string" }
      ]
    },
    "output": {
      "description": "Archive or pack file name, without extension (the target appends it).",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\]+$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "platform": { "$ref": "#/$defs/platform" },
        "container": { "$ref": "#/$defs/container" }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output"],
      "properties": {
        "output": { "$ref": "#/$defs/output" },
        "base": { "$ref": "#/$defs/base" },
        "packs": {
          "type": "array",
          "items": { "$ref": "#/$defs/packSource" }
        }
      }
    },
    "base": {
      "description": "Reuse the packs of an extracted archive folder (its manifest.json), in order. The base must be from the same platform as each target.",
      "type": "object",
      "additionalProperties": false,
      "required": ["from"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Base pack key to drop: world:0, car:3, geometry:2/q17, geometry:2/q17_g5, interface, or a folder stem such as 01_geometry_0_q2_g17."
          }
        }
      }
    },
    "packSource": {
      "oneOf": [
        { "$ref": "#/$defs/sourceHwvxPack" },
        { "$ref": "#/$defs/sourceRaw" },
        { "$ref": "#/$defs/sourceFuture" }
      ]
    },
    "sourceHwvxPack": {
      "description": "A split-pack folder inside the project (pack.json + section .bin files). type/id/sub_id default to the folder stem (03_geometry_0_q2_g17).",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": { "const": "hwvx_pack" },
        "path": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/packType" },
        "id": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "sub_id": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "version": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "output": { "$ref": "#/$defs/output" }
      }
    },
    "sourceRaw": {
      "description": "Pre-built pack bytes inserted verbatim, with an explicit key.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "type", "id"],
      "properties": {
        "kind": { "const": "raw" },
        "path": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/packType" },
        "id": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "sub_id": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "version": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "output": { "$ref": "#/$defs/output" }
      }
    },
    "sourceFuture": {
      "description": "Codegen source kinds: declared by the schema, not implemented by the compiler yet (E0040). See docs/compiler/roadmap.md.",
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["car", "world", "geometry", "items", "interface", "audio"] }
      },
      "additionalProperties": true
    }
  }
}
